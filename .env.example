# ---------------------------------------------------------------------------
# MIHENK Data Platform - environment template
#
# Copy this file to `.env` and adjust for your machine:
#     cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Rule of thumb for what belongs here:
#   - values that differ per machine or per person  -> .env
#   - values that define the project itself         -> src/data_generator/config.py
#
# Volumes, date ranges and dirty-data ratios are NOT here on purpose. They are
# part of the project definition and must be visible in the repo, next to the
# comment explaining why each number was chosen.
# ---------------------------------------------------------------------------

# --- Phase 1: local data generator -----------------------------------------

# Where generated source files are written. Relative paths resolve from the
# repository root. Keep this outside the repo if you are short on disk.
MIHENK_OUTPUT_PATH=./data

# Master random seed. Every generator derives its own sub-seed from this, so a
# single value makes the whole ~3-year dataset reproducible byte for byte.
# Change it only when you deliberately want a different dataset.
MIHENK_SEED=20260101

# Log verbosity for the generator: DEBUG | INFO | WARNING | ERROR
MIHENK_LOG_LEVEL=INFO


# --- Phase 2+: Microsoft Fabric ---------------------------------------------
# Filled in when we start loading into Fabric. Left blank here so the file
# documents the full shape of the configuration from day one.

# Fabric workspace name and the Lakehouse / Warehouse inside it.
FABRIC_WORKSPACE=
FABRIC_LAKEHOUSE=
FABRIC_WAREHOUSE=

# SQL endpoint used for the `ctl` control tables and the Gold layer.
# Found under: Warehouse -> Settings -> SQL connection string
FABRIC_SQL_ENDPOINT=
FABRIC_SQL_DATABASE=

# Entra ID (Azure AD) service principal. Interactive auth also works for a
# demo; a service principal is what a real deployment would use.
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
