                "type": "Expression"
              }
            }
          ]
        },
        "linkedService": {
          "name": "REPLACE_WITH_WAREHOUSE_CONNECTION",
          "properties": {
            "type": "DataWarehouse",
            "typeProperties": {
              "artifactId": "REPLACE_WITH_WAREHOUSE_ARTIFACT_ID",
              "endpoint": "REPLACE_WITH_WAREHOUSE_SQL_ENDPOINT",
              "workspaceId": "REPLACE_WITH_WORKSPACE_ID"
            }
          }
        }
