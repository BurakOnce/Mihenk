          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "EXEC ctl.usp_log_step_start @batch_id = '@{variables('batch_id')}', @source_id = NULL, @layer = 'silver', @step_name = '10_silver_master';",
                "type": "Expression"
              }
            }
          ]
        },
        "linkedService": {
          "name": "REPLACE_WITH_WAREHOUSE_CONNECTION",
          "properties": {
            "type": "DataWarehouse",
            "typeProperties": {
              "artifactId": "REPLACE_WITH_WAREHOUSE_ARTIFACT_ID",
