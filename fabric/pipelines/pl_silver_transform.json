{
  "name": "pl_silver_transform",
  "properties": {
    "description": "Silver katmanı: dört notebook sırayla, tek batch_id, her adım ctl.pipeline_run_log'a. Bir adım düşerse sonrakiler atlanır, batch yine kapatılır.",
    "activities": [
      {
        "name": "Set batch id",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "batch_id",
          "value": {
            "value": "@if(empty(pipeline().parameters.batch_id), concat('B', formatDateTime(utcnow(), 'yyyyMMddHHmmss')), pipeline().parameters.batch_id)",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Start batch",
        "type": "Script",
        "dependsOn": [
          {
            "activity": "Set batch id",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "EXEC ctl.usp_start_batch @batch_id = '@{variables('batch_id')}', @layer = 'silver';",
                "type": "Expression"
              }
            }
          ]
        },
        "linkedService": {
          "name": "REPLACE_WITH_WAREHOUSE_CONNECTION",
          "properties": {
            "type": "DataWarehouse",
            "typeProperties": {
              "artifactId": "REPLACE_WITH_WAREHOUSE_ARTIFACT_ID",
              "endpoint": "REPLACE_WITH_WAREHOUSE_SQL_ENDPOINT",
              "workspaceId": "REPLACE_WITH_WORKSPACE_ID"
            }
          }
        }
      },
      {
        "name": "Log start 10_silver_master",
        "type": "Script",
        "dependsOn": [
          {
            "activity": "Start batch",
            "dependencyConditions": [
              "Succeeded"
